# 构建产物
/vs-ai-proxy
/vs-ai-proxy.exe
/server
/dist/
*.exe
/.bin/platform-build-check/
/.bin/windows-build-check/
/.bin/logs.json
/.bin/logs.stats.json

# .bin 逐用例诊断产物
#
# tests/large_request_matrix_diagnostic.sh 每次运行都会在
# .bin/large-request-matrix/ 下写出 <序号>-<provider>-<model>-<字节>.json/.out。
# 这是本地可再生成的临时产物（每次跑矩阵都会新增几十个），不应进版本库。
#
# 刻意**不**做目录级忽略：同目录下的 summary.json / results.jsonl / soak-*.log /
# *-snapshot/ 是本地分析文档引用的证据，必须保留且可提交。
# 因此这里只按文件名形态精确忽略，不使用 /.bin/ 或 /.bin/large-request-matrix/。
/.bin/large-request-matrix/[0-9]*-*.json
/.bin/large-request-matrix/[0-9]*-*.out
/.bin/release-*.log

# docs/ 目录整体不纳入版本管理 —— 强制规则，见 AGENTS.md
#
# 决策变更（2026-09）：docs/ 曾于 2026-09 进入版本管理（原 docs/32 的 P0 决策），
# 现**整体移出版本管理**：文档文件保留在本地磁盘作为私有笔记，但不被 Git 跟踪、
# 不推送到 GitHub。任何 docs/ 下的文件（含子目录）都不得提交。
#
# 下方原先按文件名逐条忽略的写法已被目录级忽略取代（目录级覆盖更彻底，
# 不会因为新增文档忘记加规则而泄漏）。
/docs/

